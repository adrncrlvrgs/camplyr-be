generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model application {
  id          String              @id @default(cuid())
  seekerId    String
  jobId       String
  status      application_status  @default(PENDING)
  coverLetter String?             @db.Text // used as the optional note
  resumeUrl   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  job         job                 @relation(fields: [jobId], references: [id], onDelete: Cascade, map: "Application_jobId_fkey")
  user        user                @relation(fields: [seekerId], references: [id], onDelete: Cascade, map: "Application_seekerId_fkey")
  answers     applicationanswer[] // NEW

  @@unique([seekerId, jobId], map: "Application_seekerId_jobId_key")
  @@index([jobId], map: "Application_jobId_idx")
  @@index([seekerId], map: "Application_seekerId_idx")
}

// NEW
model applicationanswer {
  id            String        @id @default(cuid())
  applicationId String
  questionId    String?       // nullable so deleting a question keeps old answers
  questionLabel String        // snapshot of the question text at answer time
  questionType  question_type // snapshot of the type at answer time
  value         Json          // string | number | boolean | string[]
  createdAt     DateTime      @default(now())
  application   application   @relation(fields: [applicationId], references: [id], onDelete: Cascade, map: "ApplicationAnswer_applicationId_fkey")
  question      jobquestion?  @relation(fields: [questionId], references: [id], onDelete: SetNull, map: "ApplicationAnswer_questionId_fkey")

  @@unique([applicationId, questionId], map: "ApplicationAnswer_applicationId_questionId_key")
  @@index([applicationId], map: "ApplicationAnswer_applicationId_idx")
  @@index([questionId], map: "ApplicationAnswer_questionId_idx")
}

model company {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique(map: "Company_slug_key")
  logoUrl          String?
  website          String?
  location         String?
  description      String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
  job              job[]
  recruiterprofile recruiterprofile[]
}

model job {
  id           String        @id @default(cuid())
  companyId    String
  title        String
  description  String        @db.Text
  location     String?
  salaryMin    Int?
  salaryMax    Int?
  status       job_status    @default(OPEN)
  type         job_type      @default(FULL_TIME)
  requirements Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  application  application[]
  company      company       @relation(fields: [companyId], references: [id], onDelete: Cascade, map: "Job_companyId_fkey")
  questions    jobquestion[] // NEW

  @@index([companyId], map: "Job_companyId_idx")
  @@index([status], map: "Job_status_idx")
}

// NEW
model jobquestion {
  id        String              @id @default(cuid())
  jobId     String
  label     String
  type      question_type
  required  Boolean             @default(true)
  options   Json?               // string[] for SINGLE_CHOICE / MULTI_CHOICE
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @default(now()) @updatedAt
  job       job                 @relation(fields: [jobId], references: [id], onDelete: Cascade, map: "JobQuestion_jobId_fkey")
  answers   applicationanswer[]

  @@index([jobId], map: "JobQuestion_jobId_idx")
}

model post {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  content   String   @db.Text
  authorId  String
  imageUrl  String?
  updatedAt DateTime @default(now()) @updatedAt
  user      user     @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "Post_authorId_fkey")

  @@index([authorId], map: "Post_authorId_idx")
}

model recruiterprofile {
  id        String   @id @default(cuid())
  userId    String   @unique(map: "RecruiterProfile_userId_key")
  companyId String?
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  company   company? @relation(fields: [companyId], references: [id], map: "RecruiterProfile_companyId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "RecruiterProfile_userId_fkey")

  @@index([companyId], map: "RecruiterProfile_companyId_idx")
}

model seekerprofile {
  id        String   @id @default(cuid())
  userId    String   @unique(map: "SeekerProfile_userId_key")
  headline  String?
  bio       String?  @db.Text
  location  String?
  resumeUrl String?
  skills    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "SeekerProfile_userId_fkey")
}

model user {
  id               String            @id @default(cuid())
  email            String            @unique(map: "User_email_key")
  name             String?
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  googleId         String            @unique(map: "User_googleId_key")
  isOnboarded      Boolean           @default(false)
  role             user_role?
  username         String?           @unique(map: "User_username_key")
  updatedAt        DateTime          @default(now()) @updatedAt
  application      application[]
  post             post[]
  recruiterprofile recruiterprofile?
  seekerprofile    seekerprofile?

  @@index([email], map: "User_email_idx")
  @@index([role], map: "User_role_idx")
}

enum application_status {
  PENDING
  REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

enum job_status {
  DRAFT
  OPEN
  CLOSED
}

enum user_role {
  SEEKER
  RECRUITER
  ADMIN
}

enum job_type {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

// NEW
enum question_type {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  YES_NO
  NUMBER
  DATE
}